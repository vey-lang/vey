// The calendar of the board: no clock, no time zone, just days.

use "../src/dates.vey" as dates

test("a day is written the way a form writes it", fn() {
  assertEquals(dates.write(2026, 10, 3), "2026-10-03")
  assertEquals(dates.write(987, 1, 1), "0987-01-01")
})

test("a real day is accepted and a made-up one is not", fn() {
  assert(dates.isDate("2026-10-23"), "october 23 is a day")
  assert(dates.isDate("2028-02-29"), "2028 is a leap year")
  assert(!dates.isDate("2027-02-29"), "2027 is not a leap year")
  assert(!dates.isDate("2026-13-01"), "there is no thirteenth month")
  assert(!dates.isDate("2026-04-31"), "april has thirty days")
  assert(!dates.isDate("2026-00-10"), "the months start at one")
  assert(!dates.isDate("2026-1-1"), "the parts are padded")
  assert(!dates.isDate("23-10-2026"), "the year comes first")
  assert(!dates.isDate(""), "an empty text is not a day")
  assert(!dates.isDate("2026-10-23x"), "trailing letters are not a day")
  assert(!dates.isDate("1900-01-01"), "a year before 1970 is not taken")
  assert(!dates.isDate("2300-01-01"), "a year after 2200 is not taken")
})

test("century leap years follow the rule of the calendar", fn() {
  assert(dates.isLeap(2000), "2000 is a leap year")
  assert(!dates.isLeap(1900), "1900 is not a leap year")
  assert(!dates.isLeap(2100), "2100 is not a leap year")
  assert(dates.isLeap(2024), "2024 is a leap year")
  assertEquals(dates.daysInMonth(2026, 2), 28)
  assertEquals(dates.daysInMonth(2028, 2), 29)
  assertEquals(dates.daysInMonth(2026, 4), 30)
  assertEquals(dates.daysInMonth(2026, 1), 31)
})

test("a day is turned into a count and back without a loss", fn() {
  let day = "1970-01-01"
  let checks = 0
  repeat 4000 {
    assertEquals(dates.fromDays(dates.toDays(day)), day)
    day = dates.addDays(day, 1)
    checks += 1
  }
  assertEquals(checks, 4000)
  assertEquals(dates.toDays("1970-01-01"), 0)
})

test("a day may be moved over the end of a month and of a year", fn() {
  assertEquals(dates.addDays("2026-12-31", 1), "2027-01-01")
  assertEquals(dates.addDays("2026-01-01", -1), "2025-12-31")
  assertEquals(dates.addDays("2028-02-28", 1), "2028-02-29")
  assertEquals(dates.addDays("2027-02-28", 1), "2027-03-01")
  assertEquals(dates.addDays("2026-10-23", 7), "2026-10-30")
  assertEquals(dates.addDays("2026-10-23", -7), "2026-10-16")
})

test("the days between two days are counted whole", fn() {
  assertEquals(dates.daysUntil("2026-10-23", "2026-10-23"), 0)
  assertEquals(dates.daysUntil("2026-10-23", "2026-11-01"), 9)
  assertEquals(dates.daysUntil("2026-11-01", "2026-10-23"), -9)
})

test("the weekday of a known day is known", fn() {
  // 1970-01-01 was a Thursday.
  assertEquals(dates.weekday("1970-01-01"), 4)
  // 2026-10-23 is a Friday.
  assertEquals(dates.weekday("2026-10-23"), 5)
  assertEquals(dates.weekday("2026-10-25"), 0)
})

test("days are compared by their place in the calendar", fn() {
  assertEquals(dates.compare("2026-10-23", "2026-10-23"), 0)
  assert(dates.compare("2026-10-22", "2026-10-23") < 0, "the day before is before")
  assert(dates.compare("2026-10-24", "2026-10-23") > 0, "the day after is after")
  assert(dates.compare("2025-12-31", "2026-01-01") < 0, "the year is told apart")
})

test("today is the day of the clock as it is written in the data", fn() {
  let today = dates.today(time.now())
  assert(dates.isDate(today), "today is a whole day")
  assertEquals(len(today), 10)
})
