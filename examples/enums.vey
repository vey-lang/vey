enum Color {
  Red
  Green
  Blue
}

enum Shape {
  Circle(radius: number)
  Rect(width: number, height: number)
}

fn colorName(color: Color) -> string {
  return match color {
    Color.Red => "red",
    Color.Green => "green",
    Color.Blue => "blue",
  }
}

fn area(shape: Shape) -> number {
  return match shape {
    Shape.Circle(r) => r * r,
    Shape.Rect(w, h) => w * h,
  }
}

// A condition narrows the arm down.
fn describe(size: number) -> string {
  return match size {
    n if n > 100 => "huge",
    n if n > 10 => "big",
    _ => "small",
  }
}

let color = Color.Green
let shape = Shape.Circle(2.5)

print(colorName(color))
print(area(shape))
print(describe(50))
print(describe(2))
print(Color.Red)
print(Shape.Rect(3, 4))