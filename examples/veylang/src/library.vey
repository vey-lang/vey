use "./styles/site.css"
use "./site.vey" as site
use "./samples.vey" as samples

component App() {
  main {
    site.Header("library")

    section.prose {
      div.shell {
        div.prose-grid {
          div.prose-body {
            h2 { "The library" }
            p.lead {
              "The runtime that every program carries with it. It is small, it is written in JavaScript, and it is the same on Node and in the browser."
            }

            h3 id="console" { "The console" }
            ul.commands {
              li {
                code { "print(...)" }
                span { "write to the console" }
              }
              li {
                code { "input(prompt)" }
                span { "read a line from stdin, Node only" }
              }
              li {
                code { "assert(condition, message)" }
                span { "throw when the condition is false" }
              }
              li {
                code { "test(name, fn)" }
                span { "run a test" }
              }
            }

            h3 id="values" { "Values" }
            ul.commands {
              li {
                code { "str(value)" }
                span { "the value as text" }
              }
              li {
                code { "num(value)" }
                span { "the value as a number" }
              }
              li {
                code { "bool(value)" }
                span { "the value as yes or no" }
              }
              li {
                code { "type(value)" }
                span { "the name of the type" }
              }
              li {
                code { "len(value)" }
                span { "the length of a text, a list or an object" }
              }
            }

            h3 id="text" { "Text" }
            ul.commands {
              li {
                code { "upper(text)" }
                span { "the text in capitals" }
              }
              li {
                code { "lower(text)" }
                span { "the text in small letters" }
              }
              li {
                code { "trim(text)" }
                span { "the text without the space around it" }
              }
              li {
                code { "split(text, separator)" }
                span { "the parts of a text" }
              }
              li {
                code { "replace(text, search, next)" }
                span { "the text with another one in it" }
              }
              li {
                code { "includes(text, part)" }
                span { "whether the text holds the part" }
              }
              li {
                code { "text.slug(text)" }
                span { "the text as a name in an address" }
              }
              li {
                code { "text.camel(text)" }
                span { "the text as a name in the code" }
              }
            }

            h3 id="lists" { "Lists and objects" }
            ul.commands {
              li {
                code { "append(list, ...items)" }
                span { "a new list with the items in it" }
              }
              li {
                code { "map(list, fn)" }
                span { "a new list with the value of every item changed" }
              }
              li {
                code { "filter(list, fn)" }
                span { "the items the function keeps" }
              }
              li {
                code { "reduce(list, fn, first)" }
                span { "one value for the whole list" }
              }
              li {
                code { "find(list, fn)" }
                span { "the first item the function keeps" }
              }
              li {
                code { "sort(list, fn)" }
                span { "the list in order" }
              }
              li {
                code { "join(list, separator)" }
                span { "the list as a text" }
              }
              li {
                code { "keys(object)" }
                span { "the names of the fields" }
              }
              li {
                code { "omit(object, keys)" }
                span { "the object without the fields" }
              }
            }

            h3 id="data" { "Data and the web" }
            ul.commands {
              li {
                code { "json.parse(text)" }
                span { "the text as a value" }
              }
              li {
                code { "json.stringify(value)" }
                span { "the value as a text" }
              }
              li {
                code { "date.format(value, pattern)" }
                span { "the date as a text, such as YYYY-MM-DD" }
              }
              li {
                code { "query.parse(text)" }
                span { "the query of an address" }
              }
              li {
                code { "cookie.parse(header)" }
                span { "the cookies of a request" }
              }
              li {
                code { "base64.encode(value)" }
                span { "the value as base64" }
              }
              li {
                code { "url.parse(address)" }
                span { "the parts of an address" }
              }
            }

            h3 id="the-browser" { "The browser" }
            ul.commands {
              li {
                code { "bind(selector, node)" }
                span { "put a component in the page" }
              }
              li {
                code { "html(node)" }
                span { "the component as HTML" }
              }
              li {
                code { "raw(html)" }
                span { "mark HTML as trusted" }
              }
              li {
                code { "cls(...names)" }
                span { "the class names of an element" }
              }
            }

            h3 id="node" { "Node" }
            ul.commands {
              li {
                code { "fs.read(path)" }
                span { "the content of a file" }
              }
              li {
                code { "fs.write(path, value)" }
                span { "write a file" }
              }
              li {
                code { "path.join(...parts)" }
                span { "a path" }
              }
              li {
                code { "env(name, fallback)" }
                span { "a variable of the environment" }
              }
              li {
                code { "require(name)" }
                span { "a package of npm" }
              }
              li {
                code { "hash(value)" }
                span { "the fingerprint of a value" }
              }
            }

            h3 id="the-server" { "The server" }
            p {
              "A program may serve a site of its own. The routes take the address of the request and hand back what the browser gets."
            }
            site.Sample(samples.SERVER)

            div.links {
              a.button href="/language.vey" { "The language" }
              a.button href="/install.vey" { "Install Vey" }
            }
          }

          site.Contents(["The console", "Values", "Text", "Lists and objects", "Data and the web", "The browser", "Node", "The server"])
        }
      }
    }

    site.Footer()
  }
}

bind("#app", App())
