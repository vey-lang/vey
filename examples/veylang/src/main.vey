use "./styles/site.css"
use "./site.vey" as site
use "./samples.vey" as samples

component App() {
  main {
    site.Header("")

    section.hero {
      div.shell {
        div.inner {
          div.hero-text {
            h1 { "A small web language." }
            p {
              "Vey has its own syntax, its own compiler and its own runtime. The compiler is written in Rust and ships as a single binary. It emits JavaScript, so the same source runs on Node and in the browser."
            }
            site.Command("curl -fsSL https://veylang.tech/install.sh | sh")
          }
          site.Sample("hello.vey", samples.HELLO)
        }
      }
    }

    section.prose {
      div.shell {
        h2 { "What it has" }
        div.cards {
          site.Card("Markup without angle brackets", "A tag is written with its classes and its id, and it has no closing tag.")
          site.Card("Types when you want them", "A type is checked while the program is compiled and erased from the output.")
          site.Card("One binary", "The compiler, the runtime and the server of a site are all in the same binary.")
          site.Card("Modules and packages", "A module of your own, or a package of npm that is installed with npm.")
          site.Card("A server of your own", "A program may serve a site, with routes, a body and the cookies of a request.")
          site.Card("Errors that are readable", "The page of an error shows the file, the line and a caret under the wrong part.")
        }

        h2 { "A page is a program" }
        p {
          "A page is written with tag selectors instead of angle brackets. The components take arguments, and the styles are written in CSS or right next to the markup."
        }
        site.Sample("components.vey", samples.COMPONENTS)

        h2 { "The tools" }
        ul.commands {
          li {
            code { "vey new myapp" }
            span { "a project with a page, the styles and the files of the site" }
          }
          li {
            code { "vey dev" }
            span { "the site in the browser, rebuilt and reloaded while you work" }
          }
          li {
            code { "vey run" }
            span { "the site the way a host serves it" }
          }
          li {
            code { "vey build" }
            span { "the site in .dist, ready to be uploaded" }
          }
          li {
            code { "vey check" }
            span { "the whole project, with the types" }
          }
          li {
            code { "vey test" }
            span { "the tests under tests/" }
          }
        }

        div.links {
          a.button href="/language.vey" { "Read the language" }
          a.button href="/library.vey" { "The library" }
          a.button href="/install.vey" { "Install Vey" }
        }
      }
    }

    site.Footer()
  }
}

bind("#app", App())
