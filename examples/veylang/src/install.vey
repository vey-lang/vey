use "./styles/site.css"
use "./site.vey" as site

component App() {
  main {
    site.Header("install")

    section.prose {
      div.shell {
        div.prose-grid {
          div.prose-body {
            h2 { "Install Vey" }
            p.lead {
              "Vey is one binary. It compiles the programs, it runs the server of a site, and it carries the runtime that the programs need."
            }

            site.Command("curl -fsSL https://veylang.tech/install.sh | sh")

            p.note {
              p {
                "The script puts the binary in ~/.local/bin. When that folder is not in your path yet, add it:"
              }
              site.Sample('export PATH="$HOME/.local/bin:$PATH"')
            }

            h3 id="the-steps" { "The steps" }
            ol.steps {
              li {
                h3 { "Check that it works" }
                p { "The version of the compiler is printed." }
                site.Sample('vey version')
              }
              li {
                h3 { "Write a program" }
                p {
                  "A new project has a page, the styles of the site and the files that are copied as they are."
                }
                site.Sample(text.dedent('vey new myapp
                  cd myapp'))
              }
              li {
                h3 { "See it in the browser" }
                p {
                  "The server watches the files of the project and reloads the page when one of them changes."
                }
                site.Sample('vey dev')
              }
              li {
                h3 { "Build the site" }
                p {
                  "The site is written to .dist. That folder holds everything a host needs, so it can be uploaded as it is."
                }
                site.Sample('vey build')
              }
              li {
                h3 { "Publish it" }
                p {
                  "The release server hands the built site out the way a host would, without a watcher and without the reload."
                }
                site.Sample('vey run --port 3000')
              }
            }

            h3 id="the-source" { "From the source" }
            p {
              "The compiler is written in Rust. A release is built with the toolchain of Rust:"
            }
            site.Sample(text.dedent('git clone https://github.com/vey-lang/vey
              cd vey
              cargo build --release
              ./target/release/vey help'))

            div.links {
              a.button href="/language.vey" { "The language" }
              a.button href="/library.vey" { "The library" }
            }
          }

          site.Contents(["The steps", "From the source"])
        }
      }
    }

    site.Footer()
  }
}

bind("#app", App())
