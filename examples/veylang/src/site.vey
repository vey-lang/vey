// The parts that every page of the site shares.

// The bar at the top of every page.
//
// The name of the page that is open is marked, so that the reader knows
// where they are.
export component Header(active: string) {
  header.masthead {
    div.shell {
      a.brand href="/" {
        img src="/logo.svg" alt="" width="21" height="21"
        span { "Vey" }
      }
      nav.nav {
        a class={active == "language" ? "on" : ""} href="/language.vey" { "Language" }
        a class={active == "library" ? "on" : ""} href="/library.vey" { "Library" }
        a class={active == "install" ? "on" : ""} href="/install.vey" { "Install" }
      }
    }
  }
}

// The bar at the bottom of every page.
export component Footer() {
  footer.footer {
    div.shell {
      span.spark {
        img src="/logo.svg" alt="" width="16" height="16"
        span { "A small web language with its own syntax, compiler and runtime." }
      }
      a href="https://github.com/vey-lang/vey" { "The source" }
    }
  }
}

// A sample of the language, with the colours of the code.
export component Sample(text: string) {
  pre.sample {
    code { raw(highlight(text)) }
  }
}

// The command that installs Vey.
export component Command(command: string) {
  div.command {
    code { command }
    span.label { "one line" }
  }
}

// The list of the sections of a page.
export component Contents(items: [string]) {
  nav.toc {
    h4 { "On this page" }
    ul {
      for item in items {
        li {
          a href={"#" + text.slug(item)} { item }
        }
      }
    }
  }
}
