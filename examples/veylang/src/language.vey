use "./styles/site.css"
use "./site.vey" as site
use "./samples.vey" as samples

component App() {
  main {
    site.Header("language")

    section.prose {
      div.shell {
        div.prose-grid {
          div.prose-body {
            h2 { "The language" }
            p.lead {
              "A program is a list of statements and expressions. The syntax is small, and everything that is not in it is a library."
            }

            h3 id="values" { "Values" }
            p {
              "There are numbers, texts, booleans, nothing, lists and objects. A name holds a value, and a function takes arguments and hands back a value."
            }
            site.Sample("values.vey", samples.VALUES)

            h3 id="types" { "Types" }
            p {
              "Types are optional. A type is checked while the program is compiled and taken out of the output afterwards, so a program with types runs as fast as one without."
            }
            site.Sample("types.vey", samples.TYPES)

            h3 id="pipelines" { "Pipelines" }
            p {
              "A pipe hands the value on its left to the function on its right. It reads from the top down, like a list of steps."
            }
            site.Sample("pipelines.vey", samples.PIPES)

            h3 id="components" { "Components" }
            p {
              "A component is a piece of a page. It takes arguments, and the markup of the page is written with tag selectors instead of angle brackets."
            }
            site.Sample("components.vey", samples.COMPONENTS)

            h3 id="matching" { "Matching" }
            p {
              "A match looks at a value and picks the arm that fits it. A name takes the value of the match, and a condition narrows the arm down."
            }
            site.Sample("matching.vey", samples.MATCH)

            h3 id="errors" { "Errors" }
            p {
              "A block of code may fail. A catch handles the error, and a finally always runs, with or without one."
            }
            site.Sample("errors.vey", samples.ERRORS)

            h3 id="modules" { "Modules" }
            p {
              "A file that is imported is a module. The compiler joins every module of a program into one file."
            }
            site.Sample("modules.vey", samples.MODULES)

            div.links {
              a.button href="/library.vey" { "The library" }
              a.button href="/install.vey" { "Install Vey" }
            }
          }

          site.Contents(["Values", "Types", "Pipelines", "Components", "Matching", "Errors", "Modules"])
        }
      }
    }

    site.Footer()
  }
}

bind("#app", App())
